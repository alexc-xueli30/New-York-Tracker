# Mapbox — get a free token at mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# NYC Open Data Socrata — register at data.cityofnewyork.us for a free app token (server-only, not NEXT_PUBLIC_)
SOCRATA_APP_TOKEN=your_token_here

# Anthropic Claude — used only at build/ISR time, never exposed to client
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase — create a project at supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
